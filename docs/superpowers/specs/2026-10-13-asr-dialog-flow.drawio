        <mxCell id="sec3" value="③ 天气类" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="705" y="380" width="560" height="25" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="case 32 / 33&lt;br&gt;识别词：今天天气、天气怎么样&lt;br&gt;（ASRTO 自带「今天」，立刻出声）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="705" y="410" width="560" height="75" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="Serial2.print(&quot;ASK WEATHER\n&quot;)&lt;br&gt;向 ESP32 上报天气查询请求" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="705" y="515" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="speak_current_weather()&lt;br&gt;按「城市 + 现象 + 最高 + 最低」拼片段序列" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="705" y="610" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="city_fragment()&lt;br&gt;normalize_city() 去空格/撇号/连字符并转小写&lt;br&gt;再查 k_city_fragments 表（70 城，含拼音/中文/别名）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="705" y="705" width="560" height="95" as="geometry" />
        </mxCell>
        <mxCell id="wd1" value="命中 k_city_fragments？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="830" width="390" height="95" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="城市片段 166~249&lt;br&gt;如 177 =「杭州天气」；166 北京，172 呼和浩特" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="705" y="955" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="w6" value="SPK_WEATHER_PLAIN 165&lt;br&gt;兜底：只说「天气」，日志打 city not matched" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;dashed=1;dashPattern=1 2;" vertex="1" parent="1">
          <mxGeometry x="705" y="1050" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="wd2" value="s_has_weather 有天气缓存？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="1145" width="390" height="95" as="geometry" />
        </mxCell>
        <mxCell id="w7" value="asrpro_say(160)&lt;br&gt;播「天气还没更新」，本次结束" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;dashed=1;dashPattern=1 2;" vertex="1" parent="1">
          <mxGeometry x="705" y="1270" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="wd3" value="上午 9 点 == 下午 3 点？&lt;br&gt;（hourly 数组 index 9 / index 15）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="1365" width="390" height="110" as="geometry" />
        </mxCell>
        <mxCell id="w8" value="只念一个天气现象&lt;br&gt;（SPK_WEATHER_BASE 136~155）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="705" y="1505" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="w9" value="现象A + SPK_TURN 161「转」+ 现象B&lt;br&gt;例：晴间多云 + 转 + 多云" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="705" y="1600" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="w10" value="append_temperature()&lt;br&gt;SPK_TEMP_MAX + 数值 + SPK_DEGREE&lt;br&gt;SPK_TEMP_MIN + 数值 + SPK_DEGREE&lt;br&gt;数值 &lt; 0 时先插 SPK_BELOW_ZERO 159「零下」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="705" y="1695" width="560" height="95" as="geometry" />
