        <mxCell id="bus1" value="命 令 词 分 发 总 线　　（app() 按 snid 下发；⑤ 闹钟·ESP32 列由 ④ 的 ALARM 串口帧触发，不在此分发）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="3260" height="36" as="geometry" />
        </mxCell>
        <mxCell id="e_n5_bus1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="bus1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="sec2" value="② 时间类" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="560" height="25" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="case 30 / 31&lt;br&gt;识别词：现在几点、几点了&lt;br&gt;（ASRTO 自带「现在时间是」）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="560" height="75" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Serial2.print(&quot;ASK TIME\n&quot;)&lt;br&gt;向 ESP32 上报时间查询请求" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="515" width="560" height="65" as="geometry" />
        </mxCell>
        <mxCell id="td1" value="ESP32：s_time_valid&lt;br&gt;已校时？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="125" y="610" width="390" height="95" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="speak_current_time()&lt;br&gt;取 localtime，拼片段：&lt;br&gt;SPK_POINT + 时 + SPK_MINUTE + 分&lt;br&gt;分钟 &lt; 10 时先插「零」(123)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="735" width="560" height="95" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="speak_ids()&lt;br&gt;SAY 序列 →「现在时间是15点05分」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="560" height="75" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="asrpro_say(134)&lt;br&gt;播「时间还没校准」，本次结束" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;dashed=1;dashPattern=1 2;" vertex="1" parent="1">
          <mxGeometry x="40" y="965" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e_t1_t2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="t1" target="t2">
