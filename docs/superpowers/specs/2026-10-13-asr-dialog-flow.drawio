<mxfile host="app.diagrams.net" agent="Qoder" version="24.7.17" type="device">
  <diagram id="asr-dialog-e2e" name="ASR对话流程-端到端">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="2550" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="WiTime 时钟 · ASR 语音对话流程（端到端：ASRPRO V5.0 &#8596; ESP32-C3）" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="主流程横排在顶部，经「命令词分发总线」下发到各功能列；各列的播报请求向下汇入「SAY 总线」，统一交给底部播报通道。&lt;br&gt;实线 = 正常流转　　虚线 = 失败 / 拒绝 / 回退　　虚线边框的节点 = 失败分支或遗留项　　灰底横条 = 总线" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="3260" height="40" as="geometry" />
        </mxCell>

        <mxCell id="sec1" value="① 主流程（唤醒 + 分发）" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="asrpro_power_on&lt;br&gt;上电：加载识别词表与音频表&lt;br&gt;Serial2 起 ASRPRO &#8596; ESP32 链路" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="asrpro_main_loop()&lt;br&gt;主循环：等待唤醒词" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="125" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="k1" value="检测到唤醒词&lt;br&gt;「小爱同学」？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="115" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="prompt_play_by_cmd_id(0)&lt;br&gt;播「我在」；开启 20 秒识别窗口&lt;br&gt;（每识别一次自动续期 20 秒）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="125" width="360" height="75" as="geometry" />
        </mxCell>
        <mxCell id="k2" value="20 秒内识别到&lt;br&gt;命令词？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1510" y="115" width="290" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="st_reset()&lt;br&gt;清空四空收集器（st_day / st_period /&lt;br&gt;st_hour / st_min）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1840" y="125" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="app()&lt;br&gt;按 snid 分发命令词到各功能分支" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2210" y="125" width="380" height="75" as="geometry" />
